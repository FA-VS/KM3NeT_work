rule make_kofi_interval:
    localrule: True
    input:
      requested_file = "flags/Interval."+config['version']+".DONE"

rule make_kofi_contour:
    localrule: True
    input:
      requested_file = "flags/Contour."+config['version']+".DONE"

rule make_physics_target:
    localrule: True
    input:
      requested_files = [
          "flags/Benchmark."+config['version']+".DONE",
          "flags/Fit."+config['version']+".DONE",
